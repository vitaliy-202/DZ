# Упаковка ГОТОВОГО артефакта (бинарник myapp из шага «Сборка артефакта» в CI) в контейнер.
# Запуск: docker build -f Dockerfile.artifact -t dz-app .   (файл myapp должен лежать рядом)
FROM alpine:3.20
WORKDIR /root/
ENV DATA_DIR=/data
RUN mkdir -p /data
VOLUME ["/data"]
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=4s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1
COPY --chmod=0755 myapp ./myapp
CMD ["./myapp"]
